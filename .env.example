# Copy this file to .env and add your key: cp .env.example .env
# Get a key at https://console.anthropic.com  (never commit .env)
ANTHROPIC_API_KEY=

# Model that searches the web and returns the event JSON
ANTHROPIC_MODEL=claude-sonnet-5
# Small, fast model that writes the texts for AI meetup proposals
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Web searches per request (each search costs ~1 cent)
MAX_WEB_SEARCHES=8
# How long scraped events are reused before asking the AI again
CACHE_HOURS=12

PORT=5173
HTTPS_PORT=5174
